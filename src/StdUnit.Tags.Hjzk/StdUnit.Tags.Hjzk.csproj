<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <Description>Hjzk 远程IO 通信支持（建立在 ModbusTcp 之上）</Description>
	  <TargetFrameworks>net8.0;net472</TargetFrameworks>
	  <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StdUnit.Tags.ModbusTcp\StdUnit.Tags.ModbusTcp.csproj" />
  </ItemGroup>

  <!-- 驱动 schema：源生成器编译为常量（TagsGeneratedSchemas），由 HjzkSchemaProvider 注册进运行期校验；
       NuGet 包经 buildTransitive targets 注入消费项目 Schemas/Drivers/hjzk.xsd。 -->
  <ItemGroup>
    <AdditionalFiles Include="Schemas\hjzk.xsd" />
    <ProjectReference Include="..\StdUnit.Tags.SchemaGenerator\StdUnit.Tags.SchemaGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Schemas\StdUnit.Tags.Hjzk.targets" Pack="true" PackagePath="buildTransitive/StdUnit.Tags.Hjzk.targets" />
    <None Include="Schemas\hjzk.xsd" Pack="true" PackagePath="buildTransitive/Schemas/hjzk.xsd" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>
