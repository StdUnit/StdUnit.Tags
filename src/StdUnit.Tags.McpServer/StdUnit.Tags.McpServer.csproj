<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>MCP Server 扩展，把测点项目暴露给 AI 助手（ModelContextProtocol）</Description>
		<TargetFrameworks>net8.0;net472</TargetFrameworks>
		<OutputType>Library</OutputType>
		<!-- 仅 net8.0+ 有意义：net472 没有裁剪/AOT 分析器，SDK 只会报 NETSDK1210 -->
		<IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
	</PropertyGroup>
	<ItemGroup>
		<None Remove="guide.md" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\StdUnit.Tags\StdUnit.Tags.csproj" />
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Include="guide.md" />
	</ItemGroup>
	<Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>