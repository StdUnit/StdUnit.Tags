<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>依赖于 StdUnit.Tags.Core，补充项目、日志、插件等功能</Description>
    <TargetFrameworks>net8.0;net472</TargetFrameworks>
    <OutputType>Library</OutputType>
    <!-- 仅 net8.0+ 有意义：net472 没有裁剪/AOT 分析器，SDK 只会报 NETSDK1210 -->
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <XmlSerializerGeneration>GenerateSerializationAssembly</XmlSerializerGeneration>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\StdUnit.Tags.Core\StdUnit.Tags.Core.csproj" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>