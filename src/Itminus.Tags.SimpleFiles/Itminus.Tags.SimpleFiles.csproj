<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net472</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<OutputType>Library</OutputType>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Itminus.Tags\Itminus.Tags.csproj" />
	</ItemGroup>

	<!-- 驱动 schema：源生成器编译为常量（TagsGeneratedSchemas），由 SimpleFilesSchemaProvider 注册进运行期校验；
	     NuGet 包经 buildTransitive targets 注入消费项目 Schemas/Drivers/simplefiles.xsd。 -->
	<ItemGroup>
		<AdditionalFiles Include="Schemas\simplefiles.xsd" />
		<ProjectReference Include="..\Itminus.Tags.SchemaGenerator\Itminus.Tags.SchemaGenerator.csproj"
						  OutputItemType="Analyzer"
						  ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Schemas\Itminus.Tags.SimpleFiles.targets"
			  Pack="true"
			  PackagePath="buildTransitive/Itminus.Tags.SimpleFiles.targets" />
		<None Include="Schemas\simplefiles.xsd"
			  Pack="true"
			  PackagePath="buildTransitive/Schemas/simplefiles.xsd" />
	</ItemGroup>
	<Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>
