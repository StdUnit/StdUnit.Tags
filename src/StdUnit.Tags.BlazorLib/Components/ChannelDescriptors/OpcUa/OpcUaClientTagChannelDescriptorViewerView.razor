@using StdUnit.Tags.BlazorLib
@using StdUnit.Tags.BlazorLib.Components
@using StdUnit.Tags.OpcUaClient

<MudGrid Class="pl-4">
    <MudItem xs="12" sm="6" md="4">
        <MudTextField Label="Name" Variant="Variant.Filled" Value="@Descriptor.Name" ReadOnly="true" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudTextField Label="ClientName" Variant="Variant.Filled" Value="@Descriptor.OpcUaTagChannelOpt.ClientName" ReadOnly="true" />
    </MudItem>
    <MudItem xs="12" md="8">
        <MudTextField Label="DiscoveryUrl" Variant="Variant.Filled" Value="@Descriptor.OpcUaTagChannelOpt.ServerOpt.DiscoveryUrl" ReadOnly="true" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudSwitch T="bool" Label="UsePassword" Value="@Descriptor.OpcUaTagChannelOpt.ServerOpt.UsePassword" Disabled="true" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudTextField Label="UserName" Variant="Variant.Filled" Value="@Descriptor.OpcUaTagChannelOpt.ServerOpt.UserName" ReadOnly="true" />
    </MudItem>
</MudGrid>

@code {
    [Parameter, EditorRequired] public OpcUaClientTagChannelDescriptor Descriptor { get; set; } = default!;
}
