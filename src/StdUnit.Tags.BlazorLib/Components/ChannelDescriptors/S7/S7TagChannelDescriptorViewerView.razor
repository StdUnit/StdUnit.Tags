@using StdUnit.Tags.BlazorLib
@using StdUnit.Tags.BlazorLib.Components
@using StdUnit.Tags.S7

<MudGrid Class="pl-4">
    <MudItem xs="12" sm="6" md="4">
        <MudTextField Label="Name" Variant="Variant.Filled" Value="@Descriptor.Name" ReadOnly="true" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudTextField Label="IpAddr" Variant="Variant.Filled" Value="@Descriptor.IpAddr" ReadOnly="true" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudNumericField T="short" Label="Rack" Variant="Variant.Filled" Value="@Descriptor.Rack" ReadOnly="true" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudNumericField T="short" Label="Slot" Variant="Variant.Filled" Value="@Descriptor.Slot" ReadOnly="true" />
    </MudItem>
</MudGrid>

@code {
    [Parameter, EditorRequired] public S7TagChannelDescriptor Descriptor { get; set; } = default!;
}
