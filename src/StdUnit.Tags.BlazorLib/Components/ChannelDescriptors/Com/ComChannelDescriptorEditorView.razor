@using System.IO.Ports
@using StdUnit.Tags.BlazorLib
@using StdUnit.Tags.BlazorLib.Components
@using StdUnit.Tags.ComScanner.Channels

<MudGrid Class="pl-4">
    <MudItem xs="12" sm="6" md="4">
        <MudTextField Label="Name" Variant="Variant.Filled" @bind-Value="Descriptor.Name" />
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudTextField Label="Port" Variant="Variant.Filled" @bind-Value="Descriptor.Option.Port" />
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudNumericField T="int" Label="BaudRate" Variant="Variant.Filled" @bind-Value="Descriptor.Option.BaudRate" />
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudSelect T="Parity" Label="Parity" Variant="Variant.Filled" @bind-Value="Descriptor.Option.Parity">
            @foreach (var v in Enum.GetValues<Parity>())
            {
                <MudSelectItem T="Parity" Value="v">@v</MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudNumericField T="int" Label="DataBits" Variant="Variant.Filled" @bind-Value="Descriptor.Option.DataBits" />
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudSelect T="StopBits" Label="StopBits" Variant="Variant.Filled" @bind-Value="Descriptor.Option.StopBits">
            @foreach (var v in Enum.GetValues<StopBits>())
            {
                <MudSelectItem T="StopBits" Value="v">@v</MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudNumericField T="int" Label="ChannelCapacity" Variant="Variant.Filled" @bind-Value="Descriptor.Option.ChannelCapacity" />
    </MudItem>

    <MudItem xs="12" sm="6" md="8">
        <MudTextField T="string" Label="NewLine" HelperText="Use literal escape sequences like \\r\\n" Variant="Variant.Filled"
                      Value="@_newline"
                      ValueChanged="@(raw => OnNewLineChanged(raw))"
                      Immediate="true" />
    </MudItem>

    <MudItem xs="12" sm="6" md="8">
        <MudTextField T="string" Label="Script" HelperText="脚本" Variant="Variant.Filled" Lines="4"
                      @bind-Value="Descriptor.Option.ReadScript"
                      Immediate="true" />
    </MudItem>
    <MudItem xs="12" sm="6" md="8">
        <MudCheckBox T="bool" Label="调试信息？"
                      @bind-Value="Descriptor.Option.ReadScriptDebugInformationEnabled"
                      />
    </MudItem>
</MudGrid>

@code {
    [Parameter, EditorRequired] public ComChannelDescriptor Descriptor { get; set; } = default!;

    private string? _newline;

    protected override void OnParametersSet()
    {
        _newline = Escape(Descriptor.Option.NewLine);
    }

    private Task OnNewLineChanged(string? raw)
    {
        _newline = raw;
        Descriptor.Option.NewLine = Unescape(raw);
        return Task.CompletedTask;
    }

    private static string? Escape(string? s)
    {
        if (s is null) return null;
        return s.Replace("\r", "\\r").Replace("\n", "\\n").Replace("\t", "\\t");
    }

    private static string? Unescape(string? s)
    {
        if (string.IsNullOrEmpty(s)) 
            return null;
        try
        {
            return System.Text.RegularExpressions.Regex.Unescape(s);
        }
        catch
        {
			return "\\r\\n"; // ignore invalid escape sequences
        }
    }
}
