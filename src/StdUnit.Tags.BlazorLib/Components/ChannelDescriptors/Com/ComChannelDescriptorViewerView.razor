@using System.IO.Ports
@using StdUnit.Tags.BlazorLib
@using StdUnit.Tags.BlazorLib.Components
@using StdUnit.Tags.ComScanner.Channels

<MudGrid Class="pl-4">
    <MudItem xs="12" sm="6" md="4">
        <MudTextField Label="Name" Variant="Variant.Filled" Value="@Descriptor.Name" ReadOnly="true" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudTextField Label="Port" Variant="Variant.Filled" Value="@Descriptor.Option.Port" ReadOnly="true" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudNumericField T="int" Label="BaudRate" Variant="Variant.Filled" Value="@Descriptor.Option.BaudRate" ReadOnly="true" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudTextField Label="Parity" Variant="Variant.Filled" Value="@Descriptor.Option.Parity.ToString()" ReadOnly="true" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudNumericField T="int" Label="DataBits" Variant="Variant.Filled" Value="@Descriptor.Option.DataBits" ReadOnly="true" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudTextField Label="StopBits" Variant="Variant.Filled" Value="@Descriptor.Option.StopBits.ToString()" ReadOnly="true" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudNumericField T="int" Label="ChannelCapacity" Variant="Variant.Filled" Value="@Descriptor.Option.ChannelCapacity" ReadOnly="true" />
    </MudItem>
    <MudItem xs="12" sm="6" md="8">
        <MudTextField Label="NewLine" Variant="Variant.Filled" Value="@Escape(Descriptor.Option.NewLine)" ReadOnly="true" />
    </MudItem>
    <MudItem xs="12" sm="6" md="8">
        <MudTextField Label="脚本" Variant="Variant.Filled" Value="@Descriptor.Option.ReadScript" ReadOnly="true" />
    </MudItem>
    <MudItem xs="12" sm="6" md="8">
        <MudTextField Label="脚本调试信息" Variant="Variant.Filled" Value="@Descriptor.Option.ReadScriptDebugInformationEnabled" ReadOnly="true" />
    </MudItem>
</MudGrid>

@code {
    [Parameter, EditorRequired] public ComChannelDescriptor Descriptor { get; set; } = default!;

    private static string? Escape(string? s)
    {
        if (s is null) return null;
        return s.Replace("\r", "\\r")
            .Replace("\n", "\\n")
            .Replace("\t", "\\t");
    }
}
