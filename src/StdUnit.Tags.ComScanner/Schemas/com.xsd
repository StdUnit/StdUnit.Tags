<?xml version="1.0" encoding="utf-8"?>
<!--
  COM 驱动：Channel 专属子元素 schema
  命名空间：tags:com
  对应运行时类型：ComChannelDescriptor（src/StdUnit.Tags.ComScanner/Channels/ComChannelDescriptor.cs）
  默认值（见 ComChannelDescriptor.ToComChannelDescriptor）：
    Port=COM1，BaudRate=9600，Parity=None，DataBits=8，StopBits=None，
    ReadEntireLine=true，ChannelCapacity=1；NewLine/ReadScript 默认缺省。
  兼容性说明：0.10 及以前版本的拼写错误 <BaundRate> 运行期仍兼容（优先读 BaudRate，
    读不到时回退 BaundRate），但 schema 校验会把它标为非法——建议迁移到正确拼写。
  用法：
    <root xmlns:com="tags:com">
      <Channel name="COM-1" driver="COM">
        <com:Port>COM1</com:Port>
        <com:BaudRate>115200</com:BaudRate>
        <com:Parity>None</com:Parity>
        <com:DataBits>8</com:DataBits>
        <com:StopBits>One</com:StopBits>
        <com:NewLine>\n</com:NewLine>
      </Channel>
    </root>
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="tags:com"
           targetNamespace="tags:com"
           elementFormDefault="qualified">

  <!-- 设计器元数据：driver@name 必须与 ComScannerNames.DriverName 完全一致（"COM"）。 -->
  <xs:annotation><xs:appinfo>
    <driver name="COM" displayName="串口（COM）" prefix="com"/>
  </xs:appinfo></xs:annotation>

  <!-- System.IO.Ports.Parity -->
  <xs:simpleType name="ParityType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="None"/>
      <xs:enumeration value="Odd"/>
      <xs:enumeration value="Even"/>
      <xs:enumeration value="Mark"/>
      <xs:enumeration value="Space"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- System.IO.Ports.StopBits -->
  <xs:simpleType name="StopBitsType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="None"/>
      <xs:enumeration value="One"/>
      <xs:enumeration value="Two"/>
      <xs:enumeration value="OnePointFive"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="Port" type="xs:string"> <!-- "COM1" 形式的字符串 -->
    <xs:annotation><xs:appinfo><ui label="端口名" order="1" group="连接" placeholder="COM1"/></xs:appinfo></xs:annotation>
  </xs:element>
  <xs:element name="BaudRate" type="xs:int">
    <xs:annotation><xs:appinfo><ui label="波特率" order="2" group="连接" placeholder="9600"/></xs:appinfo></xs:annotation>
  </xs:element>
  <xs:element name="Parity" type="ParityType">
    <xs:annotation><xs:appinfo><ui label="校验位" order="3" group="连接" help="默认 None"/></xs:appinfo></xs:annotation>
  </xs:element>
  <xs:element name="DataBits" type="xs:int">
    <xs:annotation><xs:appinfo><ui label="数据位" order="4" group="连接" help="默认 8"/></xs:appinfo></xs:annotation>
  </xs:element>
  <xs:element name="StopBits" type="StopBitsType">
    <xs:annotation><xs:appinfo><ui label="停止位" order="5" group="连接" help="默认 None"/></xs:appinfo></xs:annotation>
  </xs:element>
  <xs:element name="NewLine" type="xs:string"> <!-- 支持转义序列，如 \n、\r\n -->
    <xs:annotation><xs:appinfo><ui label="行结束符" order="6" group="高级" placeholder="\r\n" help="支持转义序列，如 \n、\r\n"/></xs:appinfo></xs:annotation>
  </xs:element>
  <xs:element name="ReadEntireLine" type="xs:boolean">
    <xs:annotation><xs:appinfo><ui label="整行读取" order="7" group="高级" help="默认 true"/></xs:appinfo></xs:annotation>
  </xs:element>
  <xs:element name="ReadScript" type="xs:string">
    <xs:annotation><xs:appinfo><ui label="读取脚本" order="8" group="高级"/></xs:appinfo></xs:annotation>
  </xs:element>
  <xs:element name="ReadScriptDebugInformationEnabled" type="xs:boolean">
    <xs:annotation><xs:appinfo><ui label="脚本调试信息" order="9" group="高级"/></xs:appinfo></xs:annotation>
  </xs:element>
  <xs:element name="ChannelCapacity" type="xs:positiveInteger">
    <xs:annotation><xs:appinfo><ui label="通道容量" order="10" group="高级" help="默认 1"/></xs:appinfo></xs:annotation>
  </xs:element>

</xs:schema>
