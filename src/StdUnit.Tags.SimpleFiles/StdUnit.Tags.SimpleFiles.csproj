<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>简单文件支持，把测点树映射为文件树</Description>
		<TargetFrameworks>net8.0;net472</TargetFrameworks>
		<OutputType>Library</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\StdUnit.Tags\StdUnit.Tags.csproj" />
	</ItemGroup>

	<!-- 驱动 schema：源生成器编译为常量（TagsGeneratedSchemas），由 SimpleFilesSchemaProvider 注册进运行期校验；
	     NuGet 包经 buildTransitive targets 注入消费项目 Schemas/Drivers/simplefiles.xsd。 -->
	<ItemGroup>
		<AdditionalFiles Include="Schemas\simplefiles.xsd" />
		<ProjectReference Include="..\StdUnit.Tags.SchemaGenerator\StdUnit.Tags.SchemaGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Schemas\StdUnit.Tags.SimpleFiles.targets" Pack="true" PackagePath="buildTransitive/StdUnit.Tags.SimpleFiles.targets" />
		<None Include="Schemas\simplefiles.xsd" Pack="true" PackagePath="buildTransitive/Schemas/simplefiles.xsd" />
	</ItemGroup>
	<Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>
