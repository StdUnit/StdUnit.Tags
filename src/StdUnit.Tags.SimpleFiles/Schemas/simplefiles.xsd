<?xml version="1.0" encoding="utf-8"?>
<!--
  SimpleFiles 驱动：Channel 专属子元素 schema
  命名空间：tags:simplefiles
  对应运行时类型：SimpleFilesTagChannelDescriptor（src/StdUnit.Tags.SimpleFiles/Channels/SimpleFilesTagChannelDescriptor.cs）
  默认值：BaseDir 缺省时使用通道所在目录（见 SimpleFilesTagChannel）。
  用法：
    <root xmlns:sf="tags:simplefiles">
      <Channel name="file" driver="SimpleFiles">
        <sf:BaseDir>D:/temp</sf:BaseDir>
      </Channel>
    </root>
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="tags:simplefiles"
           elementFormDefault="qualified">

  <!-- 设计器元数据：driver@name 必须与 SimpleFilesNames.DriverName 完全一致。 -->
  <xs:annotation><xs:appinfo>
    <driver name="SimpleFiles" displayName="磁盘文件（SimpleFiles）" prefix="sf"/>
  </xs:appinfo></xs:annotation>

  <xs:element name="BaseDir" type="xs:string">
    <xs:annotation><xs:appinfo><ui label="数据目录" order="1" group="基础" placeholder="." help="省略时使用通道所在目录"/></xs:appinfo></xs:annotation>
  </xs:element>

</xs:schema>
