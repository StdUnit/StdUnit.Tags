<?xml version="1.0" encoding="utf-8"?>
<!--
  SimpleFiles 驱动：Channel 专属子元素 schema
  命名空间：tags:simplefiles
  对应运行时类型：SimpleFilesTagChannelDescriptor（src/StdUnit.Tags.SimpleFiles/Channels/SimpleFilesTagChannelDescriptor.cs）
  默认值：BaseDir 缺省时使用通道所在目录（见 SimpleFilesTagChannel）。
  用法：
    <root xmlns:sf="tags:simplefiles">
      <Channel name="file" driver="SimpleFiles">
        <sf:BaseDir>D:/temp</sf:BaseDir>
      </Channel>
    </root>
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="tags:simplefiles"
           elementFormDefault="qualified">

  <xs:element name="BaseDir" type="xs:string"/>

</xs:schema>
