<?xml version="1.0" encoding="utf-8"?>
<!--
  S7 驱动：Channel 专属子元素 schema
  命名空间：tags:s7
  对应运行时类型：S7TagChannelDescriptor（src/StdUnit.Tags.S7/Channels/S7TagChannelDescriptor.cs）
  默认值：IpAddr=localhost，Rack=0，Slot=1，ConnectionType=3（连接类型，0=PG/1=OP/3=PG内部）
  用法：
    <root xmlns:s7="tags:s7">
      <Channel name="S7-1" driver="S7">
        <s7:IpAddr>localhost</s7:IpAddr>
        <s7:Rack>0</s7:Rack>
        <s7:Slot>1</s7:Slot>
      </Channel>
    </root>
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="tags:s7"
           elementFormDefault="qualified">

  <!-- 设计器元数据：driver@name 必须与 S7Names.DriverName 完全一致（它就是 Channel/@driver 的取值）。
       核心 schema 无法把 driver 属性值和命名空间绑起来（XSD 1.0 不能按属性值切换内容模型），
       所以绑定声明由驱动 schema 自己持有；见 WebUi 的 /catalog 端点。 -->
  <xs:annotation><xs:appinfo>
    <driver name="S7" displayName="Siemens S7" prefix="s7"/>
  </xs:appinfo></xs:annotation>

  <!--
    注：S7 STR 测点的 maxlen 属性是 S7 专属，不在核心 TagType 中声明
    （XSD 1.0 无法让驱动扩展核心元素类型的属性约束），经核心的 xs:anyAttribute lax 放行，
    值域校验（1~255，总长 2+maxlen）由运行期强制：见 S7Utils.NormalizeS7StrTagSize。
  -->

  <xs:element name="IpAddr" type="xs:string">
    <xs:annotation><xs:appinfo><ui label="IP 地址" order="1" group="连接" placeholder="192.168.0.1"/></xs:appinfo></xs:annotation>
  </xs:element>
  <xs:element name="Rack" type="xs:short">
    <xs:annotation><xs:appinfo><ui label="机架号" order="2" group="连接" help="默认 0"/></xs:appinfo></xs:annotation>
  </xs:element>
  <xs:element name="Slot" type="xs:short">
    <xs:annotation><xs:appinfo><ui label="槽号" order="3" group="连接" help="默认 1"/></xs:appinfo></xs:annotation>
  </xs:element>
  <xs:element name="ConnectionType" type="xs:unsignedShort">
    <xs:annotation><xs:appinfo><ui label="连接类型" order="4" group="高级" help="默认 3；0=PG、1=OP、3=PG 内部"/></xs:appinfo></xs:annotation>
  </xs:element>

</xs:schema>
