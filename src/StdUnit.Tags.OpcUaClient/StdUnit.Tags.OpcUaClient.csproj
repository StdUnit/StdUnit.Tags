<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>OPC UA 通信支持</Description>
    <TargetFrameworks>net8.0;net472</TargetFrameworks>
    <OutputType>Library</OutputType>
    <!-- 本包依赖 OPC UA 栈，采用的是 OPC Foundation MIT License 1.00（不是 SPDX 标识符），
         所以用授权文件而不是 PackageLicenseExpression（后者在 Directory.Build.props 里统一设为 MIT）。 -->
    <PackageLicenseExpression></PackageLicenseExpression>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\StdUnit.Tags\StdUnit.Tags.csproj" />
  </ItemGroup>

  <!-- 驱动 schema：源生成器编译为常量（TagsGeneratedSchemas），由 OpcUaClientSchemaProvider 注册进运行期校验；
       NuGet 包经 buildTransitive targets 注入消费项目 Schemas/Drivers/opcua-client.xsd。 -->
  <ItemGroup>
    <AdditionalFiles Include="Schemas\opcua-client.xsd" />
    <ProjectReference Include="..\StdUnit.Tags.SchemaGenerator\StdUnit.Tags.SchemaGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="LICENSE" Pack="true" PackagePath="\" />
    <None Include="Schemas\StdUnit.Tags.OpcUaClient.targets"
          Pack="true"
          PackagePath="buildTransitive/StdUnit.Tags.OpcUaClient.targets" />
    <None Include="Schemas\opcua-client.xsd"
          Pack="true"
          PackagePath="buildTransitive/Schemas/opcua-client.xsd" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>