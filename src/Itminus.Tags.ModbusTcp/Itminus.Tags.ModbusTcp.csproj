<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net472</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Itminus.Tags\Itminus.Tags.csproj" />
  </ItemGroup>

  <!-- 驱动 schema：源生成器编译为常量（TagsGeneratedSchemas），由 ModbusTcpSchemaProvider 注册进运行期校验；
       NuGet 包经 buildTransitive targets 注入消费项目 Schemas/Drivers/modbustcp.xsd。 -->
  <ItemGroup>
    <AdditionalFiles Include="Schemas\modbustcp.xsd" />
    <ProjectReference Include="..\Itminus.Tags.SchemaGenerator\Itminus.Tags.SchemaGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Schemas\Itminus.Tags.ModbusTcp.targets"
          Pack="true"
          PackagePath="buildTransitive/Itminus.Tags.ModbusTcp.targets" />
    <None Include="Schemas\modbustcp.xsd"
          Pack="true"
          PackagePath="buildTransitive/Schemas/modbustcp.xsd" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>