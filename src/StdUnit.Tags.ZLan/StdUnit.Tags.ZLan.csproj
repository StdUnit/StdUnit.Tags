<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net472</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\StdUnit.Tags.ModbusTcp\StdUnit.Tags.ModbusTcp.csproj" />
  </ItemGroup>

  <!-- 驱动 schema：源生成器编译为常量（TagsGeneratedSchemas），由 ZLanTcpSchemaProvider 注册进运行期校验；
       NuGet 包经 buildTransitive targets 注入消费项目 Schemas/Drivers/zlan.xsd。 -->
  <ItemGroup>
    <AdditionalFiles Include="Schemas\zlan.xsd" />
    <ProjectReference Include="..\StdUnit.Tags.SchemaGenerator\StdUnit.Tags.SchemaGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Schemas\StdUnit.Tags.ZLan.targets" Pack="true" PackagePath="buildTransitive/StdUnit.Tags.ZLan.targets" />
    <None Include="Schemas\zlan.xsd" Pack="true" PackagePath="buildTransitive/Schemas/zlan.xsd" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>