<?xml version="1.0" encoding="utf-8"?>
<!--
  ZLanTcp 驱动：Channel 专属子元素 schema（self-contained，不依赖其他驱动 schema）
  命名空间：tags:zlan
  对应运行时类型：ZLanTcpTagChannelDescriptor（src/StdUnit.Tags.ZLan/Channels/ZLanTcpTagChannelDescriptor.cs）。
  ZLanTcpTagChannelDescriptor : ModbusTcpTagChannelDescriptor（C# 继承），
  但 schema 保持独立，避免跨项目 import 的路径解析问题。
  用法：
    <root xmlns:zl="tags:zlan">
      <Channel name="zl-1" driver="ZLanTcp">
        <zl:IpAddr>192.168.1.11</zl:IpAddr>
        <zl:Port>502</zl:Port>
      </Channel>
    </root>
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="tags:zlan"
           targetNamespace="tags:zlan"
           elementFormDefault="qualified">

  <xs:simpleType name="SingleFrameLimitType">
    <xs:restriction base="xs:unsignedShort">
      <xs:minInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="IpAddr" type="xs:string"/>
  <!-- Port 为字符串以兼容 COM 的 "COM1" 形式；ZLan 侧运行期解析为整数 -->
  <xs:element name="Port" type="xs:string"/>
  <xs:element name="MaxWriteRegisters" type="SingleFrameLimitType"/>
  <xs:element name="MaxReadRegisters" type="SingleFrameLimitType"/>
  <xs:element name="MaxReadBits" type="SingleFrameLimitType"/>

</xs:schema>
