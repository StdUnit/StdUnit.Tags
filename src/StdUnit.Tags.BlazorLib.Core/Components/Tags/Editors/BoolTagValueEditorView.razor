
@inject ISnackbar SnackbarService


<div style="display:flex; gap:12px; align-items:center;">
    <MudSwitch T="bool" @bind-Value="_checked" Color="Color.Primary" Disabled="@IsReadOnly" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Write" Disabled="@IsReadOnly">写入</MudButton>
</div>

@code {
    [Parameter, EditorRequired]
    public ITagsProject? Project { get; set; } = null!;

    [Parameter, EditorRequired]
    public ITag Tag { get; set; } = null!;

    private bool _checked;

    private bool IsReadOnly => Tag.IsReadOnly();

    protected override void OnParametersSet()
    {
        if (Tag.Value is bool b)
            _checked = b;
        else if (Tag.Value is null)
            _checked = false;
    }

    private async Task Write()
    {
        try
        {
            var entry = this.Tag.SearchEntry();
            if(entry is null)
            {
                SnackbarService.Add(@<span>未找到标签的入口信息，无法写入。</span>, Severity.Error);
                return;
            }
            if (Project is null)
            {
                SnackbarService.Add(@<span>当前项目为空，无法写入。</span>, Severity.Error);
                return;
            }
            var newvalue = _checked;
            _ = this.Project.WriteIntent(
                entry.TagName(), 
                (entry,ct) => {
                    Tag.Value = newvalue;
                    return ValueTask.CompletedTask;
                }, 
                out var task
            );
            await task;

            SnackbarService.Add(@<span>@Tag.TagName() &lt;- @newvalue</span>);
        }
        catch(Exception ex)
        {
            SnackbarService.Add
            (
                @<div>
                    @ex.Message
                </div>,
                Severity.Error
            );
        }
    }
}
