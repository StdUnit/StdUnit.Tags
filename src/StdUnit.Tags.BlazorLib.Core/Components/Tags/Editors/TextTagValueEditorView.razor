@inject ISnackbar SnackbarService

<MudTextField T="string" @bind-Value="_text" Label="值" Disabled="@IsReadOnly" Immediate="true" />
<div class="mt-2" style="display:flex; gap:12px; align-items:center;">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Write" Disabled="@IsReadOnly">写入</MudButton>
    <MudText Typo="Typo.caption">当前: @Tag.Value</MudText>
</div>


<MudPopover Open="@_popopen" Fixed="true" Class="px-4 pt-4">
    <div class="d-flex flex-column">
        <MudText>@ErrorMessage</MudText>
        <MudButton OnClick="@ToggleOPopOpen" Class="ml-auto mr-n3 mb-1" Color="Color.Error">Close</MudButton>
    </div>
</MudPopover>

@code {

    [Parameter, EditorRequired]
    public ITagsProject? Project { get; set; } 

    [Parameter, EditorRequired]
    public ITag Tag { get; set; } = null!;


    private bool _popopen;

    private void ToggleOPopOpen() => _popopen = !_popopen;
    protected string ErrorMessage { get; set; } = string.Empty;

    private string? _text;

    private bool IsReadOnly => Tag.IsReadOnly();

    protected override void OnParametersSet()
    {
        _text = Tag.Value?.ToString();
    }

    private async Task Write()
    {
        try
        {
            if (Project is null)
            {
                SnackbarService.Add(@<span>当前项目为空，无法写入。</span>, Severity.Error);
                return;
            }

            var entry = this.Tag.SearchEntry();
            if(entry is null)
            {
                SnackbarService.Add(@<span>未找到标签的入口信息，无法写入。</span>, Severity.Error);
                return;
            }
            var newvalue = _text;
            _ = this.Project.WriteIntent(
                entry.TagName(), 
                (entry,ct) => {
                    Tag.Value = newvalue;
                    return ValueTask.CompletedTask;
                }, 
                out var task
            );
            await task;
            SnackbarService.Add(@<span>@Tag.TagName() &lt;- @newvalue</span>);

        }
        catch(Exception ex)
        {
            _popopen = true;
            this.ErrorMessage = ex.Message;
            SnackbarService.Add
            (
                @<div>
                    @ex.Message
                </div>,
                Severity.Error
            );
        }
    }
}
