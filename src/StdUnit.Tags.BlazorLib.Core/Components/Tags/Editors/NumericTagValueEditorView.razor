@using System.Globalization
@using StdUnit.Tags.BlazorLib
@using StdUnit.Tags.BlazorLib.Components
@inject ISnackbar SnackbarService

<MudTextField T="string" @bind-Value="_text" Label="值" Disabled="@IsReadOnly" Immediate="true" />
<div class="mt-2" style="display:flex; gap:12px; align-items:center;">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Write" Disabled="@IsReadOnly">写入</MudButton>
    <MudText Typo="Typo.caption">当前: @Tag.Value</MudText>
</div>

@code {

    [Parameter, EditorRequired]
    public ITagsProject? Project { get; set; }

    [Parameter, EditorRequired]
    public ITag Tag { get; set; } = null!;

    private string? _text;

    private bool IsReadOnly => Tag.IsReadOnly();

    protected override void OnParametersSet()
    {
        _text = Tag.Value?.ToString();
    }

    private async Task Write()
    {
        try
        {
            var kind = Tag.TagKind();
            var s = _text ?? "0";


            var entry = this.Tag.SearchEntry();
            if(entry is null)
            {
                SnackbarService.Add(@<span>未找到标签的入口信息，无法写入。</span>, Severity.Error);
                return;
            }

            if (Project is null)
            {
                SnackbarService.Add(@<span>当前项目为空，无法写入。</span>, Severity.Error);
                return;
            }
            _ = this.Project.WriteIntent(
                entry.TagName(), 
                (entry,ct) => {

                    // Assign the correctly-typed value directly.
                    switch (kind)
                    {
                        case BuiltinTagKinds.BYTE:
                            Tag.Value = byte.Parse(s, NumberStyles.Integer, CultureInfo.InvariantCulture);
                            break;
                        case BuiltinTagKinds.INT16:
                            Tag.Value = short.Parse(s, NumberStyles.Integer, CultureInfo.InvariantCulture);
                            break;
                        case BuiltinTagKinds.UINT16:
                            Tag.Value = ushort.Parse(s, NumberStyles.Integer, CultureInfo.InvariantCulture);
                            break;
                        case BuiltinTagKinds.INT32:
                            Tag.Value = int.Parse(s, NumberStyles.Integer, CultureInfo.InvariantCulture);
                            break;
                        case BuiltinTagKinds.UINT32:
                            Tag.Value = uint.Parse(s, NumberStyles.Integer, CultureInfo.InvariantCulture);
                            break;
                        case BuiltinTagKinds.INT64:
                            Tag.Value = long.Parse(s, NumberStyles.Integer, CultureInfo.InvariantCulture);
                            break;
                        case BuiltinTagKinds.UINT64:
                            Tag.Value = ulong.Parse(s, NumberStyles.Integer, CultureInfo.InvariantCulture);
                            break;
                        case BuiltinTagKinds.FLOAT:
                            Tag.Value = float.Parse(s, NumberStyles.Float | NumberStyles.AllowThousands, CultureInfo.InvariantCulture);
                            break;
                        default:
                            throw new InvalidOperationException($"不支持的数值测点类型: {kind}");
                    }

                    return ValueTask.CompletedTask;
                }, 
                out var task
            );
            await task;
            SnackbarService.Add(@<span>@Tag.TagName() &lt;- @s</span>);

        }
        catch (Exception ex)
        {
            SnackbarService.Add(@<div>@ex.Message</div>, Severity.Error);
        }
    }
}
