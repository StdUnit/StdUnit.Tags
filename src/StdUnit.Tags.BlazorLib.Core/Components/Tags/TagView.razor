@using MudBlazor
@using StdUnit.Tags.BlazorLib
@using StdUnit.Tags.BlazorLib.Components
@using StdUnit.Tags.BlazorLib.Components.Tags
@inject IDialogService DialogService

<div style="display: grid; grid-template-columns: 1fr 3fr 1fr 1fr 3fr; align-items: center; width: 100%">
    <MudText Style="justify-self: start;">@TagName</MudText>
    <MudText Style="justify-self: start;">@TagAddress</MudText>
    <MudText Style="justify-self: start;">@TagKind (@TagSize)</MudText>
    <MudText Style="justify-self: start;">@TagAccessMode</MudText>
   
    <div style="display: flex; align-items: center">
        <MudText style="margin-right: 16px">@Value</MudText>
        <MudSpacer />


        @if(!this.IsReadOnly)
        {
            <MudTooltip Text="编辑测点值">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="OpenEditDialog"></MudIconButton>
            </MudTooltip>
        }

        @if( this.TagAccessMode == TagAccessMode.R1W)
        {
            <MudTooltip Text="标记未扫描">
                <MudIconButton Icon="@Icons.Material.Outlined.MarkunreadMailbox"
                               OnClick="MarkNotScanned">
                    IsScanned
                </MudIconButton>
            </MudTooltip>
        }


    </div>
</div>
