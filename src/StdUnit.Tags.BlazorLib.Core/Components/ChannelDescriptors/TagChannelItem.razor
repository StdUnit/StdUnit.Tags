@using StdUnit.Tags
@using StdUnit.Tags.BlazorLib
@using StdUnit.Tags.BlazorLib.Components
@using StdUnit.Tags.BlazorLib.Components.ChannelDescriptors.Editing
@inject TagChannelDescriptorRendererRegistry RendererRegistry

<MudExpansionPanels Elevation="0" Dense="true">
    <MudExpansionPanel>
        <TitleContent>
            <MudText Typo="Typo.body1">
                @Descriptor.Name 
                <MudText Typo="Typo.caption" Class="ml-2">(@Descriptor.Driver)</MudText>
			</MudText>
        </TitleContent>
        <ChildContent>
            <MudPaper Class="pa-4 ml-4 border-1 border-lime-50" Elevation="0" >
                @if (Editable)
                {
                    var editor = RendererRegistry.ResolveEditor(Descriptor);
                    if (editor is not null)
                    {
                        @editor.Edit(Descriptor, d => _ = OnDescriptorChangedAsync(d))
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No editor registered for this channel.</MudAlert>
                    }
                }
                else
                {
                    var viewer = RendererRegistry.ResolveViewer(Descriptor);
                    if (viewer is not null)
                    {
                        @viewer.View(Descriptor)
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No viewer registered for this channel.</MudAlert>
                    }
                }
            </MudPaper>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    [Parameter, EditorRequired] public TagChannelDescriptor Descriptor { get; set; } = default!;
    [Parameter] public bool Editable { get; set; }

    [Parameter] public EventCallback<TagChannelDescriptor> DescriptorChanged { get; set; }

    private async Task OnDescriptorChangedAsync(TagChannelDescriptor d)
    {
        if (DescriptorChanged.HasDelegate)
        {
            await DescriptorChanged.InvokeAsync(d);
        }
    }
}


