@using StdUnit.Tags
@using StdUnit.Tags.BlazorLib
@using StdUnit.Tags.BlazorLib.Components
@inject IDialogService DialogService
@inject ITagChannelFactory ChannelFactory

<MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Open">新增通道</MudButton>

@code {
    [Parameter] public EventCallback<TagChannelDescriptor> ChannelCreated { get; set; }

    private async Task Open()
    {
        var drivers = ChannelFactory.GetAvailableDrivers();

        var parameters = new DialogParameters<TagChannelCreateDialog>
        {
            { x => x.Drivers, drivers }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Medium };
        var dialog = await DialogService.ShowAsync<TagChannelCreateDialog>("新增通道", parameters, options);
        if (dialog is null)
            return;

        var result = await dialog.Result;
        if (result is null)
            return;

        if (!result.Canceled && result.Data is TagChannelDescriptor d)
        {
            await ChannelCreated.InvokeAsync(d);
        }
    }
}
