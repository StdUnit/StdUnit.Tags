<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- 本示例的**唯一目的**：让"WebStream 的 AOT 支持"可被 CI 验证 ——
         真的以 NativeAOT 发布成原生可执行文件、起 Kestrel、用 HttpClient 读 SSE。
         见 .github/workflows/dotnet.yml 的 aot-smoke job。 -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StdUnit.Tags\StdUnit.Tags.csproj" />
    <ProjectReference Include="..\..\src\StdUnit.Tags.SimpleFiles\StdUnit.Tags.SimpleFiles.csproj" />
    <ProjectReference Include="..\..\src\StdUnit.Tags.WebStream\StdUnit.Tags.WebStream.csproj" />
  </ItemGroup>
</Project>
