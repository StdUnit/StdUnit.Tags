<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net472</TargetFrameworks>
    <IsPackable>false</IsPackable>
	<NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);CS0067,CS1998,NU1504,NU1506</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- 仅供 net8.0 跑的测试（依赖 net8-only 的项目/运行期 API）已拆到 StdUnit.Tags.Tests.NetCoreOnly。
       McpServer 自 v1.x 起已支持 net472（走 ModelContextProtocol 的 netstandard2.0 资产），
       因此 MCP 测试留在本项目、两个 TFM 都跑。 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Compile Remove="Core\Logicets\LogicetPluginLifecycleTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Core\TagUnions\index.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="ComTags\ComProjTests\ComProjSelectorTests.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="ComTags\ComScriptTests\ComScriptTags2.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="ComTags\ComScriptTests\ComScriptTags.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="ComTags\ComScriptTests\ComScriptEmptyTags.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="ModbusTags\index.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="ModbusTags\DirectTags\index.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="OpcUaClientTags\index.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="OpcUaClientTags\DirectTags\index.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="S7Tags\index.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="SimpleFilesTags\DirectTags\index.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="S7Tags\DirectTags\index.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="HjzkTags\index.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="ZLanTags\index.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Schema 校验测试所需：从各项目 Schemas/ 目录复制 schema，从 samples/ 复制示例 XML
       （Link 保持目录结构） -->
  <ItemGroup>
    <None Include="..\..\src\StdUnit.Tags.Core\Schemas\tagsproject.xsd" Link="Schemas\tagsproject.xsd">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\..\src\StdUnit.Tags.S7\Schemas\s7.xsd" Link="Schemas\Drivers\s7.xsd">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\..\src\StdUnit.Tags.ModbusTcp\Schemas\modbustcp.xsd" Link="Schemas\Drivers\modbustcp.xsd">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\..\src\StdUnit.Tags.ZLan\Schemas\zlan.xsd" Link="Schemas\Drivers\zlan.xsd">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\..\src\StdUnit.Tags.Hjzk\Schemas\hjzk.xsd" Link="Schemas\Drivers\hjzk.xsd">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\..\src\StdUnit.Tags.ComScanner\Schemas\com.xsd" Link="Schemas\Drivers\com.xsd">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\..\src\StdUnit.Tags.OpcUaClient\Schemas\opcua-client.xsd" Link="Schemas\Drivers\opcua-client.xsd">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\..\src\StdUnit.Tags.SimpleFiles\Schemas\simplefiles.xsd" Link="Schemas\Drivers\simplefiles.xsd">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\..\samples\StdUnit.Tags.Web\index.xml" Link="Samples\Web\index.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\..\samples\StdUnit.Tags.Web\index2.xml" Link="Samples\Web\index2.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\..\samples\StdUnit.Tags.Web\index-plugin.xml" Link="Samples\Web\index-plugin.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\..\samples\WpfDemo\Tags\index.xml" Link="Samples\WpfDemo\index.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\..\samples\WpfDemo\Tags\index-2.xml" Link="Samples\WpfDemo\index-2.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\..\samples\NixMonitor\Tags\index.xml" Link="Samples\NixMonitor\index.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\StdUnit.Tags.ComScanner\StdUnit.Tags.ComScanner.csproj" />
    <ProjectReference Include="..\..\src\StdUnit.Tags.Core\StdUnit.Tags.Core.csproj" />
    <ProjectReference Include="..\..\src\StdUnit.Tags.Hjzk\StdUnit.Tags.Hjzk.csproj" />
    <ProjectReference Include="..\..\src\StdUnit.Tags.McpServer\StdUnit.Tags.McpServer.csproj" />
    <ProjectReference Include="..\..\src\StdUnit.Tags.ModbusTcp\StdUnit.Tags.ModbusTcp.csproj" />
    <ProjectReference Include="..\..\src\StdUnit.Tags.OpcUaClient\StdUnit.Tags.OpcUaClient.csproj" />
    <ProjectReference Include="..\..\src\StdUnit.Tags.R3Extensions\StdUnit.Tags.R3Extensions.csproj" />
    <ProjectReference Include="..\..\src\StdUnit.Tags.RxExtensions\StdUnit.Tags.RxExtensions.csproj" />
    <ProjectReference Include="..\..\src\StdUnit.Tags.S7\StdUnit.Tags.S7.csproj" />
    <ProjectReference Include="..\..\src\StdUnit.Tags.SchemaGenerator\StdUnit.Tags.SchemaGenerator.csproj" />
    <ProjectReference Include="..\..\src\StdUnit.Tags.SimpleFiles\StdUnit.Tags.SimpleFiles.csproj" />
    <ProjectReference Include="..\..\src\StdUnit.Tags.ZLan\StdUnit.Tags.ZLan.csproj" />
    <ProjectReference Include="..\..\src\StdUnit.Tags\StdUnit.Tags.csproj" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>