<?xml version="1.0" encoding="utf-8"?>
<root>

	<!-- 通道，可以配置多个-->
	<Channel name="S7-1" driver="S7" >
		<IpAddr>localhost</IpAddr>
		<Rack>0</Rack>
		<Slot>1</Slot>
	</Channel>
	<Channel name="S7-3" driver="S7" >
		<IpAddr>192.168.1.13</IpAddr>
		<Rack>0</Rack>
		<Slot>3</Slot>
	</Channel>
	<Channel name="COM-1" driver="COM">
		<Port>COM1</Port>
		<BaudRate>115200</BaudRate>
		<Parity>None</Parity>
		<DataBits>8</DataBits>
		<StopBits>One</StopBits>
	</Channel>


	<!-- 测点配置，可以配置多个 -->
	<TagGrp name="g1" isEntry="true" isEnabled="true" address="DB200.100.1" channel="S7-1" scanInterval="10">
		<TagGrp name="g11">
			<TagCbnt name="拍照请求" access="RO" address="DB200.100.1">
				<Tag name="拍照-请求-标志" address="DB200.100.1" type="BIT" />
				<Tag name="拍照-请求-料号" address="DB200.102" type="BYTE" />
				<Tag name="拍照-请求-程序号" address="DB200.104" type="INT16" />
			</TagCbnt>

			<TagCbnt name="拍照响应" access="R1W" address="DB200.400.0">
				<Tag name="拍照-响应-标志" address="DB200.400.0" type="BIT" />
				<Tag name="拍照-响应-B1" address="DB200.400.1" type="BIT" />
				<Tag name="拍照-响应-I2" address="DB200.400.8" type="BIT" />
			</TagCbnt>
		</TagGrp>
		<TagGrp name="g12">
		</TagGrp>
	</TagGrp>
	<TagGrp name="扫码枪" isEntry="true" isEnabled="true" channel="COM-1" scanInterval="10">
		<Tag name="输入" type="STR" access="RO"></Tag>
	</TagGrp>
</root>