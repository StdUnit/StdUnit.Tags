<?xml version="1.0" encoding="utf-8"?>
<root>

	<!-- 通道，可以配置多个-->
	<Channel name="COM-1" driver="COM">
		<Port>COM1</Port>
		<BaudRate>9600</BaudRate>
		<Parity>None</Parity>
		<DataBits>8</DataBits>
		<StopBits>One</StopBits>
	</Channel>
	<Channel name="COM-2" driver="COM">
		<NewLine>\r\n</NewLine>
		<ChannelCapacity>42</ChannelCapacity>
		<Port>COM2</Port>
		<BaudRate>9600</BaudRate>
		<Parity>None</Parity>
		<DataBits>8</DataBits>
		<StopBits>One</StopBits>
	</Channel>
	<Channel name="COM-3" driver="COM">
		<Port>COM3</Port>
		<BaudRate>9600</BaudRate>
		<Parity>None</Parity>
		<DataBits>8</DataBits>
		<StopBits>One</StopBits>
	</Channel>


	<!-- 测点配置，可以配置多个 -->

	<!-- 测点 配置 -->
	<TagGrp name="g" isEntry="true" isEnabled="true" scanInterval="10">
		<Tag name="1#扫码枪" channel="COM-1" type="STR" access="RO"></Tag>
		<Tag name="2#扫码枪" channel="COM-2" type="STR" access="RO"></Tag>
	</TagGrp>

	<TagGrp name="称重仪" isEntry="true" isEnabled="true" scanInterval="10">
	    <!-- 注意这个测点没有指定 access，会冒泡到父级 Grp 的默认值 RW -->
	    <!-- 注意：通道不能跨入口共用，所以称重仪用自己声明的 COM-3 -->
		<Tag name="1#" type="AnyLoad" channel="COM-3" ></Tag>
	</TagGrp>

	<!-- 逻辑配置，可以配置0~N个 -->
	<!--<Logicet>E:\SourceCode\揽月\StdUnit.Tags\src\Samples.Plugin1\bin\Debug\net8.0\\Samples.Plugin1.dll</Logicet>-->
</root>