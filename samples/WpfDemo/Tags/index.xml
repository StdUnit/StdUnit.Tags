<?xml version="1.0" encoding="utf-8"?>
<Project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="../../../src/StdUnit.Tags.Core/Schemas/tagsproject.xsd"
      xmlns:s7="tags:s7"
      xmlns:com="tags:com"
      xmlns:sf="tags:simplefiles">

	<!-- 通道，可以配置多个-->
	<Channel name="S7-1" driver="S7" >
		<!--<s7:IpAddr>172.16.10.20</s7:IpAddr>-->
		<s7:IpAddr>localhost</s7:IpAddr>
		<s7:Rack>0</s7:Rack>
		<s7:Slot>1</s7:Slot>
	</Channel>

	<Channel name="COM-2#" driver="COM">
		<com:Port>COM2</com:Port>
		<com:BaudRate>9600</com:BaudRate>
		<com:Parity>None</com:Parity>
		<com:DataBits>8</com:DataBits>
		<com:StopBits>One</com:StopBits>
		<com:ReadEntireLine>false</com:ReadEntireLine>
		<com:NewLine>\r</com:NewLine>
	</Channel>


	<Channel name="file" driver="SimpleFiles">
		<sf:BaseDir>D:/tmp</sf:BaseDir>
	</Channel>

	<!-- 测点配置，可以配置多个 -->
	<TagGrp name="IoBox" isEntry="true" isEnabled="true" channel="S7-1" scanInterval="0">
		<TagGrp name="通用状态">
			<TagCbnt name="PLC" address="DB200.100" access="RO">
				<Tag name="心跳请求" address="$$100.0" type="BIT" access="RO"></Tag>
				<Tag name="状态码" address="$$102.0" type="INT16" access="RW" endian="BigEndian"></Tag>
			</TagCbnt>
			<TagCbnt name="MST" address="DB201.100" access="R1W">
				<Tag name="心跳响应" address="$$100.0" type="BIT" access="R1W"></Tag>
				<Tag name="扫描周期" address="$$102.0" type="FLOAT" access="R1W"></Tag>
			</TagCbnt>

		</TagGrp>
		<TagGrp name="simpleFiles">
			<Tag name="aa" address="aa" type="BIT" access="R1W" channel="file" autoCreateFile="true"/>
			<Tag name="bb" address="bb" type="BYTE" access="R1W" channel="file" autoCreateFile="true"/>
		</TagGrp>
	</TagGrp>
	<TagGrp name="扫码枪" isEntry="true" isEnabled="false" scanInterval="10">
		<!--  引入了自定义的marker特性来标识  -->
		<Tag name="2#" type="STR" access="RO" channel="COM-2#" marker="ComScanner"/>
	</TagGrp>



	<!-- 逻辑配置，可以配置0~N个 -->
	<!--<Logicet>Samples.Plugin1.dll</Logicet>-->
</Project>