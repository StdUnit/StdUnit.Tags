@using System.IO
@using System.Xml.Linq
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.DependencyInjection
@using StdUnit.Tags
@using StdUnit.Tags.BlazorLib.Components.ChannelDescriptors
@using StdUnit.Tags.BlazorLib.Components.TagDescriptors
@using StdUnit.Tags.Web
@using StdUnit.Tags.Web.Components
@using StdUnit.Tags.Web.Tags
@inject StdUnit.Tags.BlazorLib.TagsBlazorLibJsInterop _tagsBlazorLibJsInterop
@inject IServiceScopeFactory _ssf

@page "/designer"
@rendermode InteractiveServer
@inject ITagsProjectCtrl projctrl

<PageTitle>Designer</PageTitle>

<MudPaper Class="d-flex align-items-center mt-4 mb-8">
		<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ExportProject" Class="mb-2">导出项目</MudButton>
					
		<MudInputLabel ForId="upload-project-file" Class="d-flex ml-8 mb-2 align-items-center" >
		    <MudText Color="Color.Primary" >导入项目</MudText>	
			<InputFile OnChange="ImportProject" id="upload-project-file" />
		</MudInputLabel>
</MudPaper>

<MudTabs KeepPanelsAlive="true" Elevation="2" Rounded="true" ApplyEffectsToContainer="true">

    <MudTabPanel Text="通道" Icon="@Icons.Material.Filled.AllInclusive">

        <MudPaper Class="pl-4 pb-4 pr-4 mt-4">
            <div style="display:flex; gap:12px; align-items:center;">
                <TagChannelCreateButton ChannelCreated="OnChannelCreated" />

            </div>
        </MudPaper>

        <h3 Class="mt-8">通道列表 (共@(channelDescriptors.Count)项)</h3>
        <MudPaper Class="pl-4 pb-4 pr-4">
            <TagChannelsView Descriptors="channelDescriptors" Editable="true" OnChannelDescriptorUpdated="OnChannelDescriptorUpdated" />
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="测点" Icon="@Icons.Material.Filled.Tag">
        <MudPaper class="pl-4 pb-4 mt-4" >
			<TagDescriptorDesigner Channels="@channelDescriptors"  Grps="tagGrpDescriptors"/>
        </MudPaper>
    </MudTabPanel>

</MudTabs>

@code {
	[Parameter]
	public IList<TagChannelDescriptor> channelDescriptors { get; set; } = new List<TagChannelDescriptor>();

	[Parameter]
	public IList<TagGrpDescriptor> tagGrpDescriptors { get; set; } = new List<TagGrpDescriptor>();

	private ITagsProject? importedProject;


	private void OnChannelCreated(TagChannelDescriptor args)
	{
		this.channelDescriptors.Add(args);
		InvokeAsync(StateHasChanged);
	}


	private async Task ExportProject()
	{
		// Build root document
		var root = new XElement("root");

		// Channels
		foreach (var ch in this.channelDescriptors)
		{
			try
			{
				root.Add(ch.ToXElement());
			}
			catch
			{
				// ignore individual channel export failures
			}
		}

		// Tag groups
		foreach (var grp in this.tagGrpDescriptors)
		{
			try
			{
				root.Add(grp.ToXElement());
			}
			catch
			{
				// ignore individual group export failures
			}
		}

		var doc = new XDocument(new XDeclaration("1.0", "utf-8", "yes"), root);
		var xml = doc.ToString();

		// Use interop helper to trigger file download
		await _tagsBlazorLibJsInterop.DownloadTextFile("index.xml", xml);
	}

	private async Task ImportProject(InputFileChangeEventArgs e)
	{
		var file = e.File;
		if (file == null)
			return;

		try
		{
			using var stream = file.OpenReadStream(10_000_000);
			using var reader = new StreamReader(stream);
			var content = await reader.ReadToEndAsync();

			var root = XElement.Parse(content);

			this.channelDescriptors = root.GetTagProjectChannelDescriptors().ToList();
			this.tagGrpDescriptors = root.GetTagProjectGrpDescriptors().ToList();

			using var scope = _ssf.CreateScope();
			var factory = scope.ServiceProvider.GetRequiredService<ITagsProjectFactory>();

			var projRoot = Directory.GetCurrentDirectory();
			try
			{
				this.importedProject = factory.Create(projRoot, root);
			}
			catch (Exception ex)
			{
				Console.WriteLine($"创建项目失败：{ex.Message}");
			}

			await InvokeAsync(StateHasChanged);
		}
		catch (Exception ex)
		{
			Console.WriteLine($"导入失败：{ex.Message}");
		}
	}
	private async Task OnChannelDescriptorUpdated(TagChannelsView.TagChannelDescriptorItemUpdatedArgs args)
	{
		await this.InvokeAsync(StateHasChanged);
	}
}
