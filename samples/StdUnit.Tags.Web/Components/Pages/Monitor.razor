@using System.Collections.ObjectModel
@using System.Reactive.Linq
@using System.Xml.Linq
@using StdUnit.Tags
@using StdUnit.Tags.BlazorLib.Components.Tags
@using StdUnit.Tags.Web
@using StdUnit.Tags.Web.Components

@page "/monitor"
@implements IDisposable
@rendermode InteractiveServer
@inject ITagsProjectCtrl projctrl

<PageTitle>Monitor</PageTitle>

<MudButton OnClick="@(async e=>{
    _ = Task.Run(async () =>{
        if(string.IsNullOrEmpty(this.SelectedXml) )
        {
            Console.WriteLine("请选择xml文件");
            
            return;
        }
        var root = XElement.Load(this.SelectedXml);
        await this.projctrl.StartPollAsync( null, root: root, hook: (proj, sp, ct) => Task.CompletedTask);
    });
})">启动</MudButton>

<MudButton OnClick="@(async e=>{
    await this.projctrl.StopAsync();
})">停止</MudButton>

<TagsView Project=@Project></TagsView>

<InputSelect  @bind-Value="@SelectedXml">
    <option value="index-plugin.xml">index-plugin.xml</option>
</InputSelect>

@code {
    private IDisposable? _dispose;

    [Parameter]
    public string SelectedXml { get; set; } = "index-plugin.xml";


    private ITagsProject? _project;
    public ITagsProject? Project
    {
        get => _project;
        set
        {
            _project = value;
        }
    }

    protected override Task OnInitializedAsync()
    {
        this._project = this.projctrl.Project;

        var startorstopped = Observable.FromEventPattern<TagsProjectStartedOrStopped, TagsProjectEventArgs>(
            h => this.projctrl.StartedOrStopped += h,
            h => this.projctrl.StartedOrStopped -= h
        );
        this._dispose = startorstopped
            .Subscribe(ep =>
            {
                var sender = ep.Sender;
                var args = ep.EventArgs;
                this._project = args.IsStarted ? this.projctrl.Project : null;
                this.InvokeAsync(StateHasChanged);
            });


        return base.OnInitializedAsync();
    }





    public void Dispose()
    {
        if (this._dispose is not null)
        {
            this._dispose.Dispose();
        }
    }
}
