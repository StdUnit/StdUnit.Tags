<?xml version="1.0" encoding="utf-8"?>
<Project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="../../src/StdUnit.Tags.Core/Schemas/tagsproject.xsd"
      xmlns:s7="tags:s7"
      xmlns:ua="tags:opcuaclient">

	<!-- 通道，可以配置多个-->
	<Channel name="S7-1" driver="S7" >
		<s7:IpAddr>localhost</s7:IpAddr>
		<s7:Rack>0</s7:Rack>
		<s7:Slot>1</s7:Slot>
	</Channel>
	<Channel name="OpcUaClient-2" driver="OpcUaClient">
		<ua:ClientName>client-name-1</ua:ClientName>
		<ua:ServerOpt>
			<ua:DiscoveryUrl>opc.tcp://DESKTOP-SSCIK3F:53530/OPCUA/SimulationServer</ua:DiscoveryUrl>
			<ua:UsePassword>false</ua:UsePassword>
			<ua:UserName>user</ua:UserName>
			<ua:Password>1</ua:Password>
		</ua:ServerOpt>
	</Channel>
	<!-- 测点配置，可以配置多个 -->

	<TagGrp name="IoBox" isEntry="true" isEnabled="false" channel="S7-1" scanInterval="10">
		<TagCbnt name="输入" address="DB200.0" access="RO">

			<Tag name="复位_执行键" address="DB200.0.0" type="BIT"></Tag>
			<Tag name="放行_执行键" address="DB200.0.1" type="BIT"></Tag>
		</TagCbnt>
		<TagCbnt name="输出" address="DB300.0" access="R1W">
			<Tag name="红灯" address="DB300.0.0" type="BIT"></Tag>

			<Tag name="复位_提示灯" address="DB300.10.0" type="BIT"></Tag>
		</TagCbnt>
	</TagGrp>
	
	<!--<TagGrp name="g4" isEntry="true" isEnabled="true" channel="OpcUaClient-2" scanInterval="10">
		<TagCbnt name="输入" access="RO">
			<Tag name="产品码1" address="ns=3;i=1027" />
			<Tag name="离站响应" address="ns=3;i=1036" />
		</TagCbnt>
		<Tag name="复位_提示灯" address="ns=3;s=ResetLight" />
		<Tag name="放行_提示灯" address="ns=3;s=PassLight" />
	</TagGrp>-->

	<!-- OpcUa 配置 -->
	<TagGrp name="g4" isEntry="true" isEnabled="true" channel="OpcUaClient-2" scanInterval="10">
		<TagCbnt name="输入" access="RO">
			<!--<Tag name="响应标志" address="ns=3;i=1038"></Tag>
			<Tag name="手动" address="ns=3;i=1016"></Tag>
			<Tag name="产品码1" address="ns=3;i=1027"></Tag>-->
			<Tag name="心跳请求" address="ns=3;i=1065"></Tag>
		</TagCbnt>
		<TagCbnt name="输出" access="RW">
			<!--<Tag name="绿灯" address="ns=3;s=Green"></Tag>
			<Tag name="红灯" address="ns=3;s=Red"></Tag>
			<Tag name="黄灯" address="ns=3;s=Yellow"></Tag>-->
			<Tag name="心跳响应" address="ns=3;i=1066"></Tag>
		</TagCbnt>
	</TagGrp>



	<!-- 逻辑配置，可以配置0~N个 -->
	<Logicet>Samples.Plugin1/Samples.Plugin1.dll</Logicet>
</Project>