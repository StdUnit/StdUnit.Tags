<?xml version="1.0" encoding="utf-8"?>
<Project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="../../src/StdUnit.Tags.Core/Schemas/tagsproject.xsd"
      xmlns:s7="tags:s7"
      xmlns:mb="tags:modbustcp"
      xmlns:zl="tags:zlan"
      xmlns:hj="tags:hjzk"
      xmlns:ua="tags:opcuaclient"
      xmlns:com="tags:com">

	<!-- 通道，可以配置多个-->
	<Channel name="S7-1" driver="S7" >
		<s7:IpAddr>localhost</s7:IpAddr>
		<s7:Rack>0</s7:Rack>
		<s7:Slot>1</s7:Slot>
	</Channel>
	<Channel name="ModbusTcp-2" driver="ModbusTcp">
		<mb:IpAddr>localhost</mb:IpAddr>
		<mb:Port>502</mb:Port>
	</Channel>
	<Channel name="ZLan-1" driver="ZLanTcp">
		<zl:IpAddr>localhost</zl:IpAddr>
		<zl:Port>502</zl:Port>
	</Channel>
	<Channel name="Hjzk-1" driver="HjzkIoBox">
		<hj:IpAddr>172.16.2.21</hj:IpAddr>
		<hj:Port>502</hj:Port>
	</Channel>
	<Channel name="S7-3" driver="S7" >
		<s7:IpAddr>192.168.1.13</s7:IpAddr>
		<s7:Rack>0</s7:Rack>
		<s7:Slot>3</s7:Slot>
	</Channel>
	<Channel name="OpcUaClient-2" driver="OpcUaClient">
		<ua:ClientName>client-name-1</ua:ClientName>
		<ua:ServerOpt>
			<ua:DiscoveryUrl>opc.tcp://DESKTOP-FM4T292:4840</ua:DiscoveryUrl>
			<ua:UsePassword>false</ua:UsePassword>
			<ua:UserName>user</ua:UserName>
			<ua:Password>1</ua:Password>
		</ua:ServerOpt>
		<ua:SecurityOpt>
			<ua:AutoAcceptUntrustedCertificates>true</ua:AutoAcceptUntrustedCertificates>
			<ua:RejectSHA1SignedCertificates>false</ua:RejectSHA1SignedCertificates>
			<ua:MinimumCertificateKeySize>1024</ua:MinimumCertificateKeySize>
		</ua:SecurityOpt>
	</Channel>
	<Channel name="COM-1" driver="COM">
		<com:Port>COM1</com:Port>
		<com:BaudRate>115200</com:BaudRate>
		<com:Parity>None</com:Parity>
		<com:DataBits>8</com:DataBits>
		<com:StopBits>One</com:StopBits>
	</Channel>
	<Channel name="COM-2" driver="COM">
		<com:Port>COM2</com:Port>
		<com:BaudRate>115200</com:BaudRate>
		<com:Parity>None</com:Parity>
		<com:DataBits>8</com:DataBits>
		<com:StopBits>One</com:StopBits>
	</Channel>

	<!-- 测点配置，可以配置多个 -->
