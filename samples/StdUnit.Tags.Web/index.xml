<?xml version="1.0" encoding="utf-8"?>
<Project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="../../src/StdUnit.Tags.Core/Schemas/tagsproject.xsd"
      xmlns:s7="tags:s7"
      xmlns:zl="tags:zlan"
      xmlns:hj="tags:hjzk"
      xmlns:com="tags:com">

	<!-- 通道，可以配置多个-->
	<Channel name="S7-1" driver="S7" >
		<s7:IpAddr>localhost</s7:IpAddr>
		<s7:Rack>0</s7:Rack>
		<s7:Slot>1</s7:Slot>
	</Channel>
	<Channel name="ZLan-1" driver="ZLanTcp">
		<zl:IpAddr>localhost</zl:IpAddr>
		<zl:Port>502</zl:Port>
	</Channel>
	<Channel name="Hjzk-1" driver="HjzkIoBox">
		<hj:IpAddr>172.16.10.140</hj:IpAddr>
		<hj:Port>502</hj:Port>
	</Channel>
	<Channel name="COM-1#" driver="COM">
		<com:Port>COM1</com:Port>
		<com:BaudRate>115200</com:BaudRate>
		<com:Parity>None</com:Parity>
		<com:DataBits>8</com:DataBits>
		<com:StopBits>One</com:StopBits>
	</Channel>

	<Channel name="COM-2#" driver="COM">
		<com:Port>COM2</com:Port>
		<com:BaudRate>115200</com:BaudRate>
		<com:Parity>None</com:Parity>
		<com:DataBits>8</com:DataBits>
		<com:StopBits>One</com:StopBits>
	</Channel>
	<Channel name="COM-3#" driver="COM">
		<com:Port>COM3</com:Port>
		<com:BaudRate>115200</com:BaudRate>
		<com:Parity>None</com:Parity>
		<com:DataBits>8</com:DataBits>
		<com:StopBits>One</com:StopBits>
		<com:NewLine>\n</com:NewLine>
	</Channel>
	<Channel name="COM-90#" driver="COM">
		<com:Port>COM90</com:Port>
		<com:BaudRate>115200</com:BaudRate>
		<com:Parity>None</com:Parity>
		<com:DataBits>8</com:DataBits>
		<com:StopBits>One</com:StopBits>
		<com:NewLine>\r\n</com:NewLine>
	</Channel>

	<!-- 测点配置，可以配置多个 -->

	<!-- ZLan 配置 -->
