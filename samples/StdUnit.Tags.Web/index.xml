	<!-- Hjzk 配置 -->
	<TagGrp name="IoBox" isEntry="true" isEnabled="true" channel="Hjzk-1" scanInterval="10">
		<TagCbnt name="输入" area="DI" slave="2" access="RO">
			<Tag name="复位_执行键" address="DI7" type="DI"></Tag>
			<Tag name="放行_执行键" address="DI6" type="DI"></Tag>
			<Tag name="自动"  address="DI4" type="DI"></Tag>

			<!-- 以下点位未校对 -->
			<Tag name="套筒_输出1"  address="DI8" type="DI"></Tag>
			<Tag name="套筒_输出2"  address="DI9" type="DI"></Tag>
			<Tag name="套筒_输出3"  address="DI10" type="DI"></Tag>
		</TagCbnt>
		<TagCbnt name="输出" area="DO" slave="2"  access="RW">
			<Tag name="放行_提示灯" address="DO1" type="DO"></Tag>
			<Tag name="复位_提示灯" address="DO2" type="DO"></Tag>
			<Tag name="红灯" address="DO3" type="DO"></Tag>
			<Tag name="黄灯" address="DO4" type="DO"></Tag>
			<Tag name="绿灯" address="DO5" type="DO"></Tag>
			<Tag name="警铃" address="DO6" type="DO"></Tag>
		</TagCbnt>
	</TagGrp>

	<TagGrp name="拧紧枪" isEntry="true" isEnabled="true" channel="S7-1" scanInterval="1000">

		<TagGrp name="1#">
			<TagCbnt name="拧紧请求" address="DB400.0" access="RW">
				<Tag name="请求标志" address="DB400.0.0" type="BIT"></Tag>
				<Tag name="程序号" address="DB400.2" type="INT16" endian="BigEndian"></Tag>
				<Tag name="套筒号" address="DB400.4" type="INT16" endian="BigEndian"></Tag>
				<Tag name="螺丝号" address="DB400.6" type="INT16" endian="BigEndian"></Tag>
			</TagCbnt>
			<TagCbnt name="拧紧响应" address="DB401.0" access="RO">
				<Tag name="响应标志" address="DB401.0.0" type="BIT"></Tag>
			</TagCbnt>

			<TagCbnt name="拧紧完成请求" address="DB401.10" access="RO">
				<Tag name="请求标志" address="DB401.10.0" type="BIT"></Tag>
				<Tag name="拧紧OK" address="DB401.12.0" type="BIT"></Tag>
				<Tag name="拧紧NG" address="DB401.12.1" type="BIT"></Tag>
				<Tag name="程序号" address="DB401.14" type="INT16" endian="BigEndian"></Tag>
				<Tag name="最终扭矩" address="DB401.18" type="INT32" endian="BigEndian"></Tag>
				<Tag name="最终角度" address="DB401.22" type="INT32" endian="BigEndian"></Tag>
			</TagCbnt>
			<TagCbnt name="拧紧完成响应" address="DB400.10" access="R1W">
				<Tag name="响应标志" address="DB400.10.0" type="BIT"></Tag>
			</TagCbnt>
		</TagGrp>

		<TagGrp name="2#">
			<TagCbnt name="拧紧请求" address="DB500.0" access="RW">
				<Tag name="请求标志" address="DB500.0.0" type="BIT"></Tag>
				<Tag name="程序号" address="DB500.2" type="INT16" endian="BigEndian"></Tag>
				<Tag name="套筒号" address="DB500.4" type="INT16" endian="BigEndian"></Tag>
				<Tag name="螺丝号" address="DB500.6" type="INT16" endian="BigEndian"></Tag>
			</TagCbnt>
			<TagCbnt name="拧紧响应" address="DB501.0" access="RO">
				<Tag name="响应标志" address="DB501.0.0" type="BIT"></Tag>
			</TagCbnt>

			<TagCbnt name="拧紧完成请求" address="DB501.10" access="RO">
				<Tag name="请求标志" address="DB501.10.0" type="BIT"></Tag>
				<Tag name="拧紧OK" address="DB501.12.0" type="BIT"></Tag>
				<Tag name="拧紧NG" address="DB501.12.1" type="BIT"></Tag>
				<Tag name="程序号" address="DB501.14" type="INT16" endian="BigEndian"></Tag>
				<Tag name="最终扭矩" address="DB501.18" type="INT32" endian="BigEndian"></Tag>
				<Tag name="最终角度" address="DB501.22" type="INT32" endian="BigEndian"></Tag>
			</TagCbnt>
			<TagCbnt name="拧紧完成响应" address="DB500.10" access="R1W">
				<Tag name="响应标志" address="DB500.10.0" type="BIT"></Tag>
			</TagCbnt>
		</TagGrp>

	</TagGrp>




