	<TagGrp name="扫码枪" isEntry="true" isEnabled="true" scanInterval="10">
		<Tag name="1#" type="CodeScanner" channel="COM-1#" ></Tag>
		<Tag name="2#" type="CodeScanner" channel="COM-2#" ></Tag>
	</TagGrp>
	<TagGrp name="称重仪" isEntry="true" isEnabled="true" scanInterval="10">
		<Tag name="1#" type="AnyLoad" channel="COM-3#" ></Tag>
		<Tag name="001" type="Shunzhan" channel="COM-90#" ></Tag>
	</TagGrp>

	<!-- 逻辑配置，可以配置0~N个 -->
	<Logicet>Samples.Plugin1/Samples.Plugin1.dll</Logicet>
</Project>